# ==============================================================================
# VARIABLES DE ENTORNO DEL BACKEND - SISTEMA DE GESTIÓN DE SPA
# ==============================================================================

# Puerto de escucha del servidor Express
PORT=3000

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Clave secreta para la firma y verificación de Tokens JWT
JWT_SECRET=super_secret_jwt_key_spa_management_2026_modulo8

# Tiempo de expiración del token (ej. 8h para turno laboral)
JWT_EXPIRES_IN=8h

# Configuración de Base de Datos (Sequelize)
# Dialecto: sqlite (por defecto para portabilidad inmediata) | postgres | mysql
DB_DIALECT=sqlite
DB_STORAGE=./database_spa.sqlite

# Configuración opcional para PostgreSQL o MySQL
DB_NAME=spa_management_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
